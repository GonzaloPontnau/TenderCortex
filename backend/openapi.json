{
  "openapi": "3.1.0",
  "info": {
    "title": "TenderCortex API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/ingest": {
      "post": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Ingest Document",
        "description": "Procesa un PDF y lo indexa en el vector store.",
        "operationId": "ingest_document_api_ingest_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_document_api_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/index": {
      "delete": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Clear Index",
        "description": "Elimina todos los vectores del vector store.",
        "operationId": "clear_index_api_index_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Clear Index Api Index Delete"
                }
              }
            }
          }
        }
      }
    },
    "/api/index/stats": {
      "get": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Get Index Stats",
        "description": "Obtiene estadisticas del vector store.",
        "operationId": "get_index_stats_api_index_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Index Stats Api Index Stats Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Get Documents",
        "description": "Obtiene lista de documentos indexados para sincronizar con frontend.",
        "operationId": "get_documents_api_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Documents Api Documents Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Chat",
        "description": "Procesa una pregunta usando el grafo multi-agente.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "tags": [
          "TenderCortex"
        ],
        "summary": "Chat Stream",
        "description": "Procesa una pregunta usando SSE para feedback en tiempo real.",
        "operationId": "chat_stream_api_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check con verificacion de dependencias.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentMetadata": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Dominio clasificado por el router"
          },
          "specialist_used": {
            "type": "string",
            "title": "Specialist Used",
            "description": "Nombre del subagente especializado que genero la respuesta"
          },
          "documents_retrieved": {
            "type": "integer",
            "title": "Documents Retrieved",
            "description": "Cantidad de documentos recuperados del vector store"
          },
          "documents_filtered": {
            "type": "integer",
            "title": "Documents Filtered",
            "description": "Cantidad de documentos filtrados como relevantes"
          },
          "revision_count": {
            "type": "integer",
            "title": "Revision Count",
            "description": "Numero de revisiones realizadas por el loop de refinamiento"
          },
          "audit_result": {
            "type": "string",
            "title": "Audit Result",
            "description": "Resultado de la auditoria de calidad (pass/fail)"
          },
          "quant_analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuantAnalysis"
              },
              {
                "type": "null"
              }
            ],
            "description": "Analisis cuantitativo si aplica"
          },
          "risk_assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskAssessment"
              },
              {
                "type": "null"
              }
            ],
            "description": "Evaluacion de riesgo y compliance"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "specialist_used",
          "documents_retrieved",
          "documents_filtered",
          "revision_count",
          "audit_result"
        ],
        "title": "AgentMetadata",
        "description": "Metadata sobre el flujo de agentes para trazabilidad."
      },
      "Body_ingest_document_api_ingest_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_ingest_document_api_ingest_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "chunks_processed": {
            "type": "integer",
            "title": "Chunks Processed"
          }
        },
        "type": "object",
        "required": [
          "status",
          "filename",
          "chunks_processed"
        ],
        "title": "IngestResponse",
        "examples": [
          {
            "chunks_processed": 42,
            "filename": "licitacion_2024.pdf",
            "status": "success"
          }
        ]
      },
      "QuantAnalysis": {
        "properties": {
          "chart_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Base64",
            "description": "Grafico en formato base64"
          },
          "chart_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chart Type",
            "description": "Tipo de grafico: bar, line, pie, table, none"
          },
          "insights": {
            "type": "string",
            "title": "Insights",
            "description": "Analisis textual de los datos"
          },
          "data_quality": {
            "type": "string",
            "title": "Data Quality",
            "description": "Estado de calidad de datos: clean/sanitized/incomplete"
          }
        },
        "type": "object",
        "required": [
          "insights",
          "data_quality"
        ],
        "title": "QuantAnalysis",
        "description": "Output del subagente QuanT - Analista Cuantitativo.",
        "examples": [
          {
            "chart_base64": "iVBORw0KGgoAAAANSUhEUg...",
            "chart_type": "bar",
            "data_quality": "clean",
            "insights": "El presupuesto se distribuye en 3 partidas principales."
          }
        ]
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "examples": [
          {
            "question": "Cuales son los requisitos tecnicos del pliego?"
          },
          {
            "question": "Cual es el presupuesto total de la licitacion?"
          }
        ]
      },
      "QueryResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "agent_metadata": {
            "$ref": "#/components/schemas/AgentMetadata",
            "description": "Metadata del flujo de agentes para trazabilidad"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "agent_metadata"
        ],
        "title": "QueryResponse",
        "examples": [
          {
            "agent_metadata": {
              "audit_result": "pass",
              "documents_filtered": 4,
              "documents_retrieved": 10,
              "domain": "financial",
              "revision_count": 0,
              "specialist_used": "FinancialAgent"
            },
            "answer": "El presupuesto total de la licitacion es de USD 5,000,000.",
            "sources": [
              "licitacion_2024.pdf (p.12)",
              "licitacion_2024.pdf (p.15)"
            ]
          }
        ]
      },
      "RiskAssessment": {
        "properties": {
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Risk Level",
            "description": "Nivel de riesgo detectado"
          },
          "compliance_status": {
            "type": "string",
            "enum": [
              "approved",
              "pending",
              "rejected"
            ],
            "title": "Compliance Status",
            "description": "Estado de compliance"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues",
            "description": "Lista de problemas detectados"
          },
          "gate_passed": {
            "type": "boolean",
            "title": "Gate Passed",
            "description": "Si paso el gate de revision actual"
          }
        },
        "type": "object",
        "required": [
          "risk_level",
          "compliance_status",
          "gate_passed"
        ],
        "title": "RiskAssessment",
        "description": "Output del subagente Risk Sentinel - Auditor de Compliance.",
        "examples": [
          {
            "compliance_status": "approved",
            "gate_passed": true,
            "issues": [],
            "risk_level": "low"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
